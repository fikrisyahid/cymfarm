# ==============================================================================
# CYMFARM - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Edit this file at the repository root (/.env).
# Running `bun run env:sync` or `bun run dev` automatically syncs this into /main.

# App Config
NEXT_PUBLIC_APP_NAME="CymFarm"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Drizzle ORM / PostgreSQL Direct Connection String (Transaction or Session Pooler)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cymfarm"
