# ==============================================================================
# CYMFARM - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Simpan file ini di root repository (/.env).
# Menjalankan `bun run dev`, `bun run build`, atau `bun run env:sync`
# otomatis menyinkronkan file ini ke /main/.env dan /main/.env.local.

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Drizzle ORM & PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection string PostgreSQL langsung (Transaction pooler atau direct port 5432)
# Contoh Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Contoh Localhost: postgresql://postgres:password@localhost:5432/cymfarm
DATABASE_URL="postgresql://postgres:password@localhost:5432/cymfarm"

# ------------------------------------------------------------------------------
# 2. BUILT-IN ACCOUNTS (Simple Auth Tanpa Registrasi Publik)
# ------------------------------------------------------------------------------
# Akun Admin: Akses penuh ke Lapangan, Riwayat, dan Admin Studio (/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="supersecretpassword"

# Akun User / Anggota Keluarga: Akses Lapangan (/lapangan) & Riwayat (/riwayat)
USER_USERNAME="keluarga"
USER_PASSWORD="keluargapassword"
