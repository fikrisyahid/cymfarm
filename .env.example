# ==============================================================================
# CYMFARM - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Edit this file at the repository root (/.env).
# Running `bun run env:sync` or `bun run dev` automatically syncs this into /main.

# App Config
NEXT_PUBLIC_APP_NAME="CymFarm"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Simple Built-In Accounts (No Registration)
# 1. Admin Account: Full access (/lapangan, /analisa, and /admin)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# 2. User / Family Account: Field & Analytics access only (/lapangan and /analisa)
USER_USERNAME=""
USER_PASSWORD=""

# Session Secret
AUTH_SECRET="cymfarm-family-secret-key-2026"

# Supabase Configuration (Free Tier - Setup Later)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Drizzle ORM / PostgreSQL Direct Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/cymfarm"
